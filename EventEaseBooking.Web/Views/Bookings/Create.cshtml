@model BookingFormViewModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="EventId" class="form-label"></label>
                <select asp-for="EventId" asp-items="Model.Events" class="form-select">
                    <option value="">-- Select an event --</option>
                </select>
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" asp-items="Model.Venues" class="form-select">
                    <option value="">-- Select a venue --</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>
            <p class="form-text">Double-booking prevention is enforced from Part 2 onward.</p>
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
