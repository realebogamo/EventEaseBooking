@model Booking
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete Booking</h1>

<p>Are you sure you want to delete this booking?</p>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Event</dt>
            <dd class="col-sm-8">@Model.Event?.EventName</dd>
            <dt class="col-sm-4">Venue</dt>
            <dd class="col-sm-8">@Model.Venue?.VenueName</dd>
            <dt class="col-sm-4">Booked On</dt>
            <dd class="col-sm-8">@Model.BookingDate.ToString("g")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
