@model Event
@{
    ViewData["Title"] = "Delete Event";
    var blockingBookings = ViewBag.BlockingBookings as IEnumerable<Booking> ?? Enumerable.Empty<Booking>();
}

<h1>Delete Event</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (blockingBookings.Any())
{
    <div class="alert alert-danger">
        <p class="mb-2"><strong>This event cannot be deleted.</strong> It has @blockingBookings.Count() active booking(s):</p>
        <ul class="mb-0">
            @foreach (var b in blockingBookings)
            {
                <li>@b.Venue?.VenueName</li>
            }
        </ul>
    </div>
}
else
{
    <p>Are you sure you want to delete this event?</p>
}

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventName)</dt>
            <dd class="col-sm-9">@Model.EventName</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventStartDate)</dt>
            <dd class="col-sm-9">@Model.EventStartDate.ToString("d")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventEndDate)</dt>
            <dd class="col-sm-9">@Model.EventEndDate.ToString("d")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EventId" />
    <button type="submit" class="btn btn-danger" disabled="@(blockingBookings.Any() ? "disabled" : null)">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
