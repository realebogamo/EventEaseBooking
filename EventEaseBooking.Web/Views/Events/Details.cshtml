@model Event
@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid mb-3" />
        }
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventName)</dt>
            <dd class="col-sm-9">@Model.EventName</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventStartDate)</dt>
            <dd class="col-sm-9">@Model.EventStartDate.ToString("d")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventEndDate)</dt>
            <dd class="col-sm-9">@Model.EventEndDate.ToString("d")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EventTypeId)</dt>
            <dd class="col-sm-9">@(Model.EventType?.TypeName ?? "—")</dd>
        </dl>
    </div>
</div>

@if (Model.Bookings.Any())
{
    <h2 class="h5">Booked Venue@(Model.Bookings.Count > 1 ? "s" : "")</h2>
    <div class="row mb-3">
    @foreach (var booking in Model.Bookings)
    {
        <div class="col-md-3 text-center mb-3">
            @if (!string.IsNullOrWhiteSpace(booking.Venue?.ImageUrl))
            {
                <img src="@booking.Venue.ImageUrl" alt="@booking.Venue.VenueName" class="img-thumbnail mb-1" />
            }
            <div>
                <a asp-controller="Venues" asp-action="Details" asp-route-id="@booking.VenueId">@booking.Venue?.VenueName</a>
            </div>
        </div>
    }
    </div>
}
else
{
    <p class="text-muted">This event does not have a venue booked yet.</p>
}

<a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
